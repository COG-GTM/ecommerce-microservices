# API gateway base URL (Spring Cloud Gateway)
VITE_API_BASE_URL=http://localhost:8181

# "true" renders the mockup fixtures without a backend; "false" calls the gateway
# and signs in through Keycloak (Authorization Code + PKCE) before the app renders
VITE_USE_MOCK=true

# Keycloak public client used for the PKCE login (no client secret)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=spring-boot-microservices-realm
VITE_KEYCLOAK_CLIENT_ID=pos-webapp

# Local-dev only override: a pasted access token skips the Keycloak redirect. Never commit a real token.
VITE_API_TOKEN=
