# API gateway base URL (Spring Cloud Gateway)
VITE_API_BASE_URL=http://localhost:8181

# "true" renders the mockup fixtures without a backend; "false" calls the gateway
VITE_USE_MOCK=true

# Keycloak public client for the POS login flow
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=spring-boot-microservices-realm
VITE_KEYCLOAK_CLIENT_ID=gap-pos
