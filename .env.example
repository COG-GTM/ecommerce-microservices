# Copy to .env and replace every CHANGE_ME with a distinct strong value, e.g.:
#   awk '!/^#/ && /CHANGE_ME/{c="openssl rand -hex 24"; c|getline v; close(c); sub(/CHANGE_ME/,v)}1' .env.example > .env
# Values are interpolated into connection strings/JAAS config: use URL-safe characters (hex is fine).
# docker compose refuses to start while any of these are unset.

# Host interface for published ports. Keep 127.0.0.1 unless the host is firewalled.
BIND_ADDRESS=127.0.0.1

# MySQL (order service)
MYSQL_ORDER_ROOT_PASSWORD=CHANGE_ME
MYSQL_ORDER_USER=order_service
MYSQL_ORDER_PASSWORD=CHANGE_ME

# MySQL (inventory service)
MYSQL_INVENTORY_ROOT_PASSWORD=CHANGE_ME
MYSQL_INVENTORY_USER=inventory_service
MYSQL_INVENTORY_PASSWORD=CHANGE_ME

# MongoDB (product service)
MONGO_ROOT_USER=mongo_admin
MONGO_ROOT_PASSWORD=CHANGE_ME
MONGO_APP_USER=product_service
MONGO_APP_PASSWORD=CHANGE_ME

# Keycloak
KEYCLOAK_DB_ROOT_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN_USER=kc_admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# Kafka SASL/PLAIN
KAFKA_BROKER_USER=broker
KAFKA_BROKER_PASSWORD=CHANGE_ME
KAFKA_CLIENT_USER=ecommerce
KAFKA_CLIENT_PASSWORD=CHANGE_ME

# Grafana
GRAFANA_ADMIN_USER=grafana_admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
