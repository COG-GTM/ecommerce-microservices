# Copy to .env (gitignored, owner-readable only) and give every empty *_PASSWORD a distinct long random value, e.g.:
#   (umask 077 && awk '!/^#/ && /_PASSWORD=$/{c="openssl rand -hex 24"; c|getline v; close(c); $0=$0 v}1' .env.example > .env)
# Values are interpolated into connection strings: use URL-safe characters (hex is fine).
# docker compose refuses to start while any password is unset or empty.

# Host interface for the published database ports. Keep 127.0.0.1 unless the host is firewalled.
DB_BIND_ADDRESS=127.0.0.1

# MySQL (order service)
MYSQL_ORDER_ROOT_PASSWORD=
MYSQL_ORDER_USER=order_service
MYSQL_ORDER_PASSWORD=

# MySQL (inventory service)
MYSQL_INVENTORY_ROOT_PASSWORD=
MYSQL_INVENTORY_USER=inventory_service
MYSQL_INVENTORY_PASSWORD=

# MongoDB (product service)
MONGO_ROOT_USER=mongo_admin
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=product_service
MONGO_APP_PASSWORD=
