# Copy to .env (gitignored, mode 600, never overwritten) and replace every CHANGE_ME, e.g.:
#   (set -C && umask 077 && GRAFANA_PW=$(openssl rand -hex 24) && export GRAFANA_PW && awk '{gsub(/CHANGE_ME/, ENVIRON["GRAFANA_PW"])} 1' .env.example > .env)

# Grafana admin login (http://localhost:3000). Minimum 16 characters.
GRAFANA_ADMIN_USER=grafana-admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Host interface Grafana is published on. Keep 127.0.0.1 unless Grafana sits
# behind an authenticated reverse proxy.
GRAFANA_BIND_ADDRESS=127.0.0.1
